# HBase shell lookups, generated by lake/hbase/HBaseSink.scala with keys from this load.
#   hbase shell lake/hbase/demo_queries.hbase

# 1. the latest 3 requests of the busiest customer (fatima@savannaaid.example, 215 requests): a prefix scan
scan 'gss_requests', {ROWPREFIXFILTER => 'fatima@savannaaid.example#', LIMIT => 3, COLUMNS => ['r:sent_at', 'r:origin_iata', 'r:dest_iata', 'r:cargo_type', 'r:weight_kg', 'r:status']}

# 2. one request by its full key: a single get
get 'gss_requests', 'fatima@savannaaid.example#8207252761#M-2026-010760'

# 3. a request that still needs information from the customer
get 'gss_requests', '+971501228493#8213562087#M-2026-008153', {COLUMNS => ['r:missing_fields', 'r:confidence', 'r:status']}

# 4. all rows (expected 10707)
count 'gss_requests', INTERVAL => 5000
exit
