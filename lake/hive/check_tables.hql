-- Generated by lake/hive/HiveDdl.scala: Hive's row counts next to the counts Spark saw.
-- Small data: run the counting jobs inside the Hive process instead of on YARN.
SET mapreduce.framework.name=local;
SET hive.compute.query.using.stats=false;
SET hive.cli.print.header=true;

SELECT t.table_name, t.hive_rows, t.spark_rows,
       CASE WHEN t.hive_rows = t.spark_rows THEN 'OK' ELSE 'DIFFERENT' END AS result
FROM (
  SELECT 'dim_aircraft' AS table_name, COUNT(*) AS hive_rows, CAST(4 AS BIGINT) AS spark_rows FROM gss.dim_aircraft
  UNION ALL
  SELECT 'dim_airport' AS table_name, COUNT(*) AS hive_rows, CAST(16 AS BIGINT) AS spark_rows FROM gss.dim_airport
  UNION ALL
  SELECT 'dim_customer' AS table_name, COUNT(*) AS hive_rows, CAST(60 AS BIGINT) AS spark_rows FROM gss.dim_customer
  UNION ALL
  SELECT 'dim_date' AS table_name, COUNT(*) AS hive_rows, CAST(1218 AS BIGINT) AS spark_rows FROM gss.dim_date
  UNION ALL
  SELECT 'dim_supplier' AS table_name, COUNT(*) AS hive_rows, CAST(66 AS BIGINT) AS spark_rows FROM gss.dim_supplier
  UNION ALL
  SELECT 'document_link' AS table_name, COUNT(*) AS hive_rows, CAST(6111 AS BIGINT) AS spark_rows FROM gss.document_link
  UNION ALL
  SELECT 'fact_cost' AS table_name, COUNT(*) AS hive_rows, CAST(5109 AS BIGINT) AS spark_rows FROM gss.fact_cost
  UNION ALL
  SELECT 'fact_defect' AS table_name, COUNT(*) AS hive_rows, CAST(107 AS BIGINT) AS spark_rows FROM gss.fact_defect
  UNION ALL
  SELECT 'fact_event' AS table_name, COUNT(*) AS hive_rows, CAST(449 AS BIGINT) AS spark_rows FROM gss.fact_event
  UNION ALL
  SELECT 'fact_flight' AS table_name, COUNT(*) AS hive_rows, CAST(1426 AS BIGINT) AS spark_rows FROM gss.fact_flight
  UNION ALL
  SELECT 'fact_invoice' AS table_name, COUNT(*) AS hive_rows, CAST(1437 AS BIGINT) AS spark_rows FROM gss.fact_invoice
  UNION ALL
  SELECT 'fact_maintenance' AS table_name, COUNT(*) AS hive_rows, CAST(295 AS BIGINT) AS spark_rows FROM gss.fact_maintenance
  UNION ALL
  SELECT 'flight_documents' AS table_name, COUNT(*) AS hive_rows, CAST(1393 AS BIGINT) AS spark_rows FROM gss.flight_documents
  UNION ALL
  SELECT 'flight_key_map' AS table_name, COUNT(*) AS hive_rows, CAST(6546 AS BIGINT) AS spark_rows FROM gss.flight_key_map
  UNION ALL
  SELECT 'request' AS table_name, COUNT(*) AS hive_rows, CAST(10707 AS BIGINT) AS spark_rows FROM gss.request
  UNION ALL
  SELECT 'message' AS table_name, COUNT(*) AS hive_rows, CAST(39381 AS BIGINT) AS spark_rows FROM gss.message
  UNION ALL
  SELECT 'dq_report' AS table_name, COUNT(*) AS hive_rows, CAST(16 AS BIGINT) AS spark_rows FROM gss.dq_report
  UNION ALL
  SELECT 'unlinked_documents' AS table_name, COUNT(*) AS hive_rows, CAST(46 AS BIGINT) AS spark_rows FROM gss.unlinked_documents
  UNION ALL
  SELECT 'zz_type_test' AS table_name, COUNT(*) AS hive_rows, CAST(1 AS BIGINT) AS spark_rows FROM gss.zz_type_test
) t
ORDER BY t.table_name;

-- Type smoke test. Expected: 1234567.89  2024-03-12 04:41:07  2024-03-12  42  9000000000  true  Société
SELECT * FROM gss.zz_type_test;
